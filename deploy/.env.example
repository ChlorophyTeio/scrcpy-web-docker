# Generate real values with: python3 tools/init-env.py --output deploy/.env
COMPOSE_PROFILES=database
SCRCPYCAT_VERSION=0.1.4
SCRCPYCAT_IMAGE=chlorophyimo/scrcpycat:0.1.4
SCRCPYCAT_MAA_IMAGE=chlorophyimo/scrcpycat-maa:0.1.4
SCRCPYCAT_CACHE_IMAGE=chlorophyimo/scrcpycat-cache:0.1.4
SCRCPYCAT_NETWORK=scrcpycat
SCRCPYCAT_EXTERNAL_NETWORK=false
SCRCPYCAT_PUBLIC_URL=https://localhost:9015
SCRCPYCAT_HTTPS_PORT=9015
SCRCPYCAT_ADMIN_USERNAME=admin
SCRCPYCAT_ADMIN_PASSWORD=replace-with-your-password
SCRCPYCAT_JWT_SECRET=replace-with-a-long-random-secret
SCRCPYCAT_POSTGRES_PASSWORD=replace-with-a-database-password
SCRCPYCAT_POSTGRES_DSN=postgres://scrcpycat:replace-with-a-database-password@postgres:5432/scrcpycat?sslmode=disable
SCRCPYCAT_WEBRTC_HOST_IPS=127.0.0.1
SCRCPYCAT_WEBRTC_UDP_MIN=40000
SCRCPYCAT_WEBRTC_UDP_MAX=40100
MAA_DEVICE=
